# Copy to .env.local and fill in. Every key here is read somewhere in the app;
# missing optional keys disable their feature with a clear error, they do not crash.

# Firebase web app config (Project settings > General > Your apps). Public by
# design; Firestore security rules protect the data, not this config.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Set to 1 to point Auth and Firestore at local emulators (development only).
NEXT_PUBLIC_FIREBASE_EMULATOR=

# Google Gemini key for AI bouquet descriptions (optional; feature degrades).
GEMINI_API_KEY=

# Cloudflare R2 image storage (admin uploads return 503 until these are set).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Datadog log intake for server-side error reporting (optional).
DD_API_KEY=
DD_SITE=
